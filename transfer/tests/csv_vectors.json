{
  "about": "Invented cells and files for the CSV export and import (issue 'CSV export and import'). Both the server and the app run this file. `cells`: a text cell the person typed (`text`) and how it is written to the file (`cell`); the app reverses it by removing exactly one leading quote when the rest of the cell starts with any number of quotes followed by one of = + - @ tab CR LF. `round_trips`: after the `accounts` and `custom_categories` exist, importing `records` (rows without a line number to keep, `row` is the line of the file) and exporting the dataset gives exactly `csv` after the byte order mark, and reading `csv` the way the app does gives `records` again. Text columns are `name` (of an account and of a category), `category_name`, `account_name`, `person` and `note`; amounts are decimal strings of the currency's digits; the whole-number columns of the salary months are numbers.",
  "cells": [
    {
      "name": "a plain text is not changed",
      "text": "Weekly shop",
      "cell": "Weekly shop"
    },
    {
      "name": "equals",
      "text": "=Refund",
      "cell": "'=Refund"
    },
    {
      "name": "a bare equals sign",
      "text": "=",
      "cell": "'="
    },
    {
      "name": "plus",
      "text": "+1",
      "cell": "'+1"
    },
    {
      "name": "minus",
      "text": "-5 dollars",
      "cell": "'-5 dollars"
    },
    {
      "name": "at",
      "text": "@home",
      "cell": "'@home"
    },
    {
      "name": "tab first",
      "text": "\tindented",
      "cell": "'\tindented"
    },
    {
      "name": "carriage return first",
      "text": "\rx",
      "cell": "'\rx"
    },
    {
      "name": "line feed first",
      "text": "\nx",
      "cell": "'\nx"
    },
    {
      "name": "one quote then equals",
      "text": "'=x",
      "cell": "''=x"
    },
    {
      "name": "two quotes then plus",
      "text": "''+x",
      "cell": "'''+x"
    },
    {
      "name": "a quote then a letter is not changed",
      "text": "'tip",
      "cell": "'tip"
    },
    {
      "name": "quotes inside are not changed",
      "text": "rock 'n' roll",
      "cell": "rock 'n' roll"
    },
    {
      "name": "a formula character inside is not changed",
      "text": "a=b+c-d@e",
      "cell": "a=b+c-d@e"
    },
    {
      "name": "a space first is not changed",
      "text": " =x",
      "cell": " =x"
    },
    {
      "name": "an empty cell",
      "text": "",
      "cell": ""
    },
    {
      "name": "Arabic equals",
      "text": "=مرحبا",
      "cell": "'=مرحبا"
    },
    {
      "name": "Arabic text is not changed",
      "text": "كتاب",
      "cell": "كتاب"
    }
  ],
