# ============================================================
#  .env.example — copy to .env and adjust (never commit .env)
#
#    cp .env.example .env
#
#  docker-compose.yml reads .env for ${VAR} defaults and passes the
#  whole file into the app / celery / celery-beat containers, so any
#  variable added here reaches Django. Every value below has a working
#  default in docker-compose.yml — .env is optional.
# ============================================================

# ── Django ────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=dev-secret-key-change-in-production
DEBUG=True
# 10.0.2.2 is the Android emulator's alias for the host machine.
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,10.0.2.2
# Browser origins allowed to call the API (a web client on another port). Empty = none.
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Origins that may send a CSRF-protected request over HTTPS (the admin panel behind a proxy). Empty = none.
CSRF_TRUSTED_ORIGINS=
# Where this runs: development, staging or production. The database email outbox is refused in production.
APP_ENVIRONMENT=development
# The path of the admin panel. Staging and production use another one, not admin.
ADMIN_URL=admin
# Signs the access and refresh tokens (HS256). At least 32 random bytes, never the same as SECRET_KEY.
# Staging and production need their own: openssl rand -hex 32
JWT_SIGNING_KEY=dev-only-signing-key-change-in-production-0123456789abcdef
# The id of the current signing key. To rotate: give the new key a new id and list the old one below.
JWT_KEY_ID=k1
# JWT_PREVIOUS_KEYS=k0:old-signing-key-that-still-verifies
# Seconds the access token lives.
ACCESS_TOKEN_LIFETIME_SECONDS=600
# Days a refresh token lives, renewed by each refresh.
REFRESH_TOKEN_LIFETIME_DAYS=30
# Days after which a session ends whatever its activity.
SESSION_ABSOLUTE_LIFETIME_DAYS=90
# Seconds in which a refresh token that was just rotated is accepted again (a lost response).
REFRESH_REPLAY_WINDOW_SECONDS=30
# Check new passwords against known breaches (Pwned Passwords, k-anonymity: only a 5-character hash
# prefix leaves the server; an unreachable service skips the check). False to forbid outbound calls.
PWNED_PASSWORD_CHECK=True
# Reverse proxies in front of the app. 0 in development; behind a proxy set the real number.
NUM_PROXIES=0
# The secret key of the Cloudflare Turnstile widget, the bot challenge that sign-in asks for after repeated
# failures (docs/sign-in-challenge.md). Empty switches the challenge off. To try it locally use Cloudflare's
# dummy secret that always passes, 1x0000000000000000000000000000000AA. Staging and production need a real one.
TURNSTILE_SECRET_KEY=
# The hostnames of that widget, comma separated (public); a token solved on another host is refused. Empty accepts
# any hostname, which the dummy secret above needs.
TURNSTILE_HOSTNAMES=

# Fingerprint sign-in with a device key (ADR 0018). An Android key is accepted only with a verified key
# attestation, unless this is False, which only development may use (an emulator has no hardware key; the
# deploy check refuses it elsewhere). Staging and production set the package name of the app and the SHA-256
# digests (hex, comma separated) of the certificates that sign it; leave them empty here.
DEVICE_KEY_REQUIRE_ATTESTATION=False
DEVICE_KEY_ANDROID_PACKAGE=
DEVICE_KEY_ANDROID_CERT_SHA256=

# ── Logging and production-only switches ──────────────────────────────
# Level of the application log and of the Django framework log (DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=INFO
DJANGO_LOG_LEVEL=INFO
# Read by the production settings only (config/settings/production.py). Redirect HTTP to HTTPS, and the
# seconds of the HSTS header; keep HSTS at 0 until HTTPS is confirmed on the final domain.
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=0
# APP_RELEASE (the commit that /healthz reports in X-Release) is set by the production image build; never set it here.

# ── PostgreSQL (the db service; DATABASE_URL is built from these) ─────
POSTGRES_USER=django
POSTGRES_PASSWORD=django_pass
POSTGRES_DB=django_dev
# Or point Django at an external (managed) database instead of the db service:
# DATABASE_URL=postgres://user:password@host:5432/database?sslmode=require
# With an external DATABASE_URL, Celery Beat stays idle so it does not schedule jobs on that database.
# Set this to true only when it should run there anyway (then: docker compose restart celery-beat).
# BEAT_ON_EXTERNAL_DATABASE=false

# ── Redis / Celery / Email are wired to the compose services by default.
# Override only if you point at external services:
# REDIS_URL=redis://redis:6379/0
# CELERY_BROKER_URL=redis://redis:6379/1
# CELERY_RESULT_BACKEND=redis://redis:6379/2
# EMAIL_HOST=mailpit
# EMAIL_PORT=1025
# Emails go by SMTP to Mailpit. Set this to save them to the database instead, and read the code in the
# admin panel (development and staging only; production refuses it):
# EMAIL_BACKEND=outbox.backends.DatabaseEmailBackend
# Hours that the saved emails of the outbox are kept before the daily purge deletes them.
# OUTBOX_RETENTION_HOURS=24
# Real delivery with Resend over HTTPS (staging and production, ADR 0024; docs/staging.md). Set the backend, the sender
# on a domain verified in Resend, and the API key. The key is a secret: set it in the host's environment, never here.
# EMAIL_BACKEND=anymail.backends.resend.EmailBackend
# DEFAULT_FROM_EMAIL=Money Scribe <noreply@mail.example.com>
# RESEND_API_KEY=
