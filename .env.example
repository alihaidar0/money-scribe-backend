# ============================================================
#  .env.example — copy to .env and adjust (never commit .env)
#
#    cp .env.example .env
#
#  docker-compose.yml reads .env for ${VAR} defaults and passes the
#  whole file into the app / celery / celery-beat containers, so any
#  variable added here reaches Django. Every value below has a working
#  default in docker-compose.yml — .env is optional.
# ============================================================

# ── Django ────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=dev-secret-key-change-in-production
DEBUG=True
# 10.0.2.2 is the Android emulator's alias for the host machine.
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,10.0.2.2
# Browser origins allowed to call the API (a web client on another port). Empty = none.
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# CSRF_TRUSTED_ORIGINS=https://example.com
# Where this runs: development, staging or production. The database email outbox is refused in production.
APP_ENVIRONMENT=development
# The path of the admin panel. Staging and production use another one, not admin.
ADMIN_URL=admin

# ── PostgreSQL (the db service; DATABASE_URL is built from these) ─────
POSTGRES_USER=django
POSTGRES_PASSWORD=django_pass
POSTGRES_DB=django_dev
# Or point Django at an external (managed) database instead of the db service:
# DATABASE_URL=postgres://user:password@host:5432/database?sslmode=require

# ── Redis / Celery / Email are wired to the compose services by default.
# Override only if you point at external services:
# REDIS_URL=redis://redis:6379/0
# CELERY_BROKER_URL=redis://redis:6379/1
# CELERY_RESULT_BACKEND=redis://redis:6379/2
# EMAIL_HOST=mailpit
# EMAIL_PORT=1025
# Emails go by SMTP to Mailpit. Set this to save them to the database instead, and read the code in the
# admin panel (development and staging only; production refuses it):
# EMAIL_BACKEND=outbox.backends.DatabaseEmailBackend
# Hours that the saved emails of the outbox are kept before the daily purge deletes them.
# OUTBOX_RETENTION_HOURS=24
