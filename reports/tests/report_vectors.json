{
  "about": "Invented cases for the month report and the debts report (issue 'Reports and Overview'). Both the server and the app run this file. A `month` case sets up `settings`, `custom_categories`, `transactions` (a `category` is a built-in key such as `groceries`, or `custom:<name>`), `deleted_categories` (custom categories deleted after the transactions are saved, so their records move to `other`) and asks for the month report of `month` in `currency` (`null`: leave it out). `expected` is the answer without `month` and `currency`. A `custom:<name>` `category_id` stands for the id the server gave that category. A `debts` case sets up `debts` with `repayments`, and `today`, and asks for the debts report; `expected` lists the items without their `id`. All amounts are decimal strings of the currency's digits. A month paid twice follows the pay cycle of the Settings pay days (20 and 5 unless set): its first part runs from the 20th to the 4th of the next month, its second from the 5th to the 19th, and the month is both together. An income joins the part whose pay day is nearest to its date unless the case names a part. The built-in ids are the fixed ones of the data migration.",
  "cases": [
    {
      "name": "a transaction on the last day of the first part and on the first day of the second, a month paid twice",
      "kind": "month",
      "currency": "RUB",
      "inputs": {
        "month": "2026-10",
        "settings": {
          "payment_mode": "two_payments"
        },
        "transactions": [
          {
            "kind": "expense",
            "amount": "10.00",
            "currency": "RUB",
            "date": "2026-11-04",
            "category": "groceries"
          },
          {
            "kind": "expense",
            "amount": "20.00",
            "currency": "RUB",
            "date": "2026-11-05",
            "category": "dining"
          },
          {
            "kind": "expense",
            "amount": "5.00",
            "currency": "RUB",
            "date": "2026-11-05",
            "category": "groceries"
          },
          {
            "kind": "income",
            "amount": "100.00",
            "currency": "RUB",
            "date": "2026-10-21",
            "category": "scholarship"
          }
        ]
      },
      "expected": {
        "has_data": true,
        "currencies": [
          "RUB"
        ],
        "income_transactions": "100.00",
        "purchases": "35.00",
        "categories": [
          {
            "category_id": "0198f2a0-0000-7000-8000-000000000002",
            "category_key": "dining",
            "name": "Dining",
            "icon": "dining",
            "amount": "20.00"
          },
          {
            "category_id": "0198f2a0-0000-7000-8000-000000000001",
            "category_key": "groceries",
            "name": "Groceries",
            "icon": "groceries",
            "amount": "15.00"
          }
        ],
        "first_part": {
          "income_transactions": "100.00",
          "purchases": "10.00",
          "categories": [
            {
              "category_id": "0198f2a0-0000-7000-8000-000000000001",
              "category_key": "groceries",
              "name": "Groceries",
              "icon": "groceries",
              "amount": "10.00"
            }
          ]
        },
        "second_part": {
          "income_transactions": "0.00",
          "purchases": "25.00",
          "categories": [
            {
              "category_id": "0198f2a0-0000-7000-8000-000000000002",
              "category_key": "dining",
              "name": "Dining",
              "icon": "dining",
              "amount": "20.00"
            },
